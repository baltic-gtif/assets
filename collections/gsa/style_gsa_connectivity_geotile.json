{
  "legend": [
    {
      "title": "Ecosystem Connectivity",
      "range": ["#d73027", "#fc8d59", "#fee08b", "#1a9850"],
      "domain": [">0–1", ">1-2.5", ">2.5–4.5", ">4.5-10"],
      "scaleType": "categorical",
      "markType": "rect",
      "boundTo": { "key": "metric", "value": "a4_connectivity" }
    },
    {
      "title": "Ecosystem Connectivity Evolution (from previous year to current year)",
      "range": ["#8b0000", "#ff0000", "#ffff66", "#ccffcc", "#66cc66", "#33a02c", "#006400"],
      "domain": ["<-5", "-5–0", "0–2", "2–5", "5–6", "6–8", ">8"],
      "scaleType": "categorical",
      "markType": "rect",
      "boundTo": { "key": "metric", "value": "ab1_connectivity_evolution" }
    }
  ],
  
  "stroke-width": 3,
  "stroke-color": "#f4843650",

  "jsonform": {
    "type": "object",
    "title": "Data configuration",
    "properties": {
      "metric": {
        "title": "Metric",
        "type": "string",
        "enum": ["a4_connectivity", "ab1_connectivity_evolution"],
        "options": {
          "enum_titles": [
            "Ecosystem Connectivity",
            "Ecosystem Connectivity Evolution"
          ]
        },
        "default": "a4_connectivity"
      }
    }
  },

  "fill-color": [
    "case",

    ["==", ["var", "metric"], "ab1_connectivity_evolution"],
    [
      "case",
      ["!", ["has", "ab1_connectivity_evolution"]], [0, 0, 0, 0],

      ["<", ["get", "ab1_connectivity_evolution"], -5], "#8b0000",
      ["<=", ["get", "ab1_connectivity_evolution"], 0], "#ff0000",
      ["<=", ["get", "ab1_connectivity_evolution"], 2], "#ffff66",
      ["<=", ["get", "ab1_connectivity_evolution"], 5], "#ccffcc",
      ["<=", ["get", "ab1_connectivity_evolution"], 6], "#66cc66",
      ["<=", ["get", "ab1_connectivity_evolution"], 8], "#33a02c",
      [">", ["get", "ab1_connectivity_evolution"], 8], "#006400",

      "#000000"
    ],

    ["==", ["var", "metric"], "a4_connectivity"],
    [
      "case",
      ["!", ["has", "a4_connectivity"]], [0, 0, 0, 0],
    
      ["<=", ["get", "a4_connectivity"], 1], "#d73027",
      ["<=", ["get", "a4_connectivity"], 2.5], "#fc8d59",
      ["<=", ["get", "a4_connectivity"], 4.5], "#fee08b",
      ["<=", ["get", "a4_connectivity"], 10], "#1a9850",
    
      "#000000"
    ],

    [215, 235, 215, 0.25]
  ],

  "tooltip": [
    { "id": "a0_id", "title": "Internal ID", "decimals": 0 },
    { "id": "a1_area_ha", "title": "Parcel area (ha)", "decimals": 1 },
    { "id": "a2_classification", "title": "Category" },
    { "id": "a3_psl_kodas", "title": "Type" },
    { "id": "a4_connectivity", "title": "Ecosystem Connectivity", "decimals": 3 },
    
    { "id": "ab0_connectivity_LULCpreviousyear", "title": "Ecosystem Connectivity (from previous year LULC)", "decimals": 3 },
    { "id": "ab1_connectivity_evolution", "title": "Ecosystem Connectivity Evolution (from previous year)", "decimals": 3 }
  ],

  "variables": { "metric": "a4_connectivity" }
}
